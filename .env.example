APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain,
# SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=lax (or strict).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI providers. Only use proxy URLs that you control: they receive your API keys.
MISTRAL_KEY=
OPEN_ROUTER_KEY_1=
OPEN_ROUTER_KEY_2=
GEMINI_KEY_1=
GEMINI_KEY_2=
EMAIL_ADMIN=

GEMINI_PROXY_URL=https://gemini-proxy-ten-chi.vercel.app/api/v1beta/interactions
GEMINI_MODEL=gemini-3.6-flash
OPEN_ROUTER_PROXY_URL=https://openrouter-proxy-plum.vercel.app/api/v1/chat/completions
OPEN_ROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
MISTRAL_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
# In Docker use host.docker.internal; for `php artisan serve` use 127.0.0.1.
LM_STUDIO_URL=http://host.docker.internal:1234/api/v1/chat
LM_STUDIO_MODEL=google/gemma-4-12b-qat
LM_STUDIO_API_KEY=
LM_STUDIO_TEMPERATURE=0.7
LM_STUDIO_MAX_OUTPUT_TOKENS=2000
LM_STUDIO_REASONING=off
LM_STUDIO_TIMEOUT=180
LM_STUDIO_CONNECT_TIMEOUT=10
AI_TIMEOUT=90

YANDEX_GPT_URL=https://ai.api.cloud.yandex.net/v1/responses
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=gpt-oss-120b/latest
YANDEX_GPT_TEMPERATURE=0.7
YANDEX_GPT_MAX_OUTPUT_TOKENS=5000
YANDEX_GPT_TIMEOUT=90
YANDEX_GPT_CONNECT_TIMEOUT=10

# GigaChat. Use the Authorization Key from the GigaChat API project,
# or set GIGACHAT_CLIENT_ID and GIGACHAT_CLIENT_SECRET.
# Individuals normally use GIGACHAT_API_PERS; legal entities use GIGACHAT_API_B2B.
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CHAT_URL=https://api.giga.chat/v1/chat/completions
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_TEMPERATURE=0.7
GIGACHAT_MAX_TOKENS=2000
GIGACHAT_TIMEOUT=90
GIGACHAT_CONNECT_TIMEOUT=10
GIGACHAT_CA_BUNDLE=

# Send the generated AI comment to the authenticated user's email.
AI_EMAIL_NOTIFICATIONS=true

APP_FULLNAME="Библия ИИ"
APP_DESC="Изучайте Библию с помощью ИИ"
